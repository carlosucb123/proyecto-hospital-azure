{
	"name": "df_gold_dim_diagnostico2",
	"properties": {
		"folder": {
			"name": "gold2.0"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_gold_dim_diagnostico",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          COLUMN_NAME as string,",
				"          DATA_TYPE as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    COLUMN_NAME,\\n    DATA_TYPE\\nFROM INFORMATION_SCHEMA.COLUMNS\\nWHERE TABLE_SCHEMA = \\'silver\\'\\nAND TABLE_NAME = \\'diagnoses\\'',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}